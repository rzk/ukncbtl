file(MAKE_DIRECTORY "${TEST_DIR}")
foreach(layout IN ITEMS different matching)
  set(match "--unset=UKNCBTL_TEST_SCREENSHOT_MATCH_DISPLAY")
  if(layout STREQUAL "matching")
    set(match "UKNCBTL_TEST_SCREENSHOT_MATCH_DISPLAY=1")
  endif()
  set(screenshot "${TEST_DIR}/worker-${layout}-日本.png")
  file(REMOVE "${screenshot}")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "${match}" UKNCBTL_TEST_SAVE_DURING_FRAME=1 SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy
    "UKNCBTL_TEST_SCREENSHOT_PATH=${screenshot}" "${APP}" --smoke-test --sound
    RESULT_VARIABLE result ERROR_VARIABLE error TIMEOUT 12)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "SDL concurrent screenshot smoke test failed with ${layout} modes (${result}): ${error}")
  endif()
  if(NOT EXISTS "${screenshot}")
    message(FATAL_ERROR "Screenshot with ${layout} modes was not saved before shutdown")
  endif()
  file(READ "${screenshot}" header OFFSET 0 LIMIT 24 HEX)
  if(NOT header MATCHES "^89504e470d0a1a0a0000000d494844520000028000000240")
    message(FATAL_ERROR "Screenshot with ${layout} modes is not a 640x576 PNG: ${header}")
  endif()
  file(SHA256 "${screenshot}" ${layout}_hash)
  file(REMOVE "${screenshot}")
endforeach()
if(NOT different_hash STREQUAL matching_hash)
  message(FATAL_ERROR "Screenshot contents changed with the display mode")
endif()
