file(MAKE_DIRECTORY "${TEST_DIR}")
set(source "${TEST_DIR}/source.ini")
set(destination "${TEST_DIR}/converted.ini")
set(expected "${TEST_DIR}/expected.ini")
file(REMOVE "${source}" "${destination}" "${expected}")
string(ASCII 207 240 russian)
string(ASCII 208 159 209 128 russian_utf8)
file(WRITE "${source}" "[UKNCBTL]\nPath=${russian}\n")
file(WRITE "${expected}" "[UKNCBTL]\nPath=${russian_utf8}\n")
file(READ "${source}" original HEX)

execute_process(COMMAND "${IMPORTER}" windows-1251 "${source}" "${destination}"
  RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Import failed (${status}): ${stderr}")
endif()
file(READ "${destination}" converted HEX)
file(READ "${expected}" expected_hex HEX)
if(NOT converted STREQUAL expected_hex)
  message(FATAL_ERROR "Unexpected UTF-8 output: ${converted}")
endif()
file(READ "${source}" after HEX)
if(NOT after STREQUAL original)
  message(FATAL_ERROR "Import modified the source")
endif()

execute_process(COMMAND "${IMPORTER}" windows-1251 "${source}" "${destination}"
  RESULT_VARIABLE status ERROR_VARIABLE stderr)
if(status EQUAL 0 OR NOT stderr MATCHES "destination already exists")
  message(FATAL_ERROR "Existing destination was not rejected: ${stderr}")
endif()
file(READ "${destination}" after HEX)
if(NOT after STREQUAL converted)
  message(FATAL_ERROR "Import modified an existing destination")
endif()

execute_process(COMMAND "${IMPORTER}" invalid "${source}" "${destination}"
  RESULT_VARIABLE status ERROR_VARIABLE stderr)
if(NOT status EQUAL 2 OR NOT stderr MATCHES "Usage:")
  message(FATAL_ERROR "Invalid encoding did not show usage: ${stderr}")
endif()
file(REMOVE "${destination}")
string(ASCII 128 233 western)
string(ASCII 226 130 172 195 169 western_utf8)
file(WRITE "${source}" "[UKNCBTL]\nPath=${western}\n")
file(WRITE "${expected}" "[UKNCBTL]\nPath=${western_utf8}\n")
execute_process(COMMAND "${IMPORTER}" windows-1252 "${source}" "${destination}"
  RESULT_VARIABLE status ERROR_VARIABLE stderr)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Windows-1252 import failed (${status}): ${stderr}")
endif()
file(READ "${destination}" converted HEX)
file(READ "${expected}" expected_hex HEX)
if(NOT converted STREQUAL expected_hex)
  message(FATAL_ERROR "Unexpected Windows-1252 output: ${converted}")
endif()
file(REMOVE "${source}" "${destination}" "${expected}")
