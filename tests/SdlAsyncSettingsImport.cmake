file(MAKE_DIRECTORY "${TEST_DIR}")
set(source "${TEST_DIR}/legacy-日本.ini")
set(destination "${TEST_DIR}/settings-日本.ini")
foreach(mode IN ITEMS complete quit invalid)
  file(WRITE "${destination}" "[SDLPreview]\nSound=1\n[Custom]\nKeep=yes\n")
  set(extra_env)
  set(expected_sound 0)
  if(mode STREQUAL "invalid")
    file(WRITE "${source}" "[Other]\nSound=0\n")
    set(expected_sound 1)
    list(APPEND extra_env UKNCBTL_TEST_SETTINGS_IMPORT_FAILURE=1)
  else()
    file(WRITE "${source}" "[UKNCBTL]\nSound=0\n")
  endif()
  if(mode STREQUAL "quit")
    list(APPEND extra_env UKNCBTL_TEST_SETTINGS_IMPORT_EXIT=1)
  elseif(mode STREQUAL "complete")
    list(APPEND extra_env "UKNCBTL_TEST_SCREENSHOT_PATH=${source}" UKNCBTL_TEST_SCREENSHOT_CONFLICT=1)
  endif()
  file(SHA256 "${source}" original)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy
    "UKNCBTL_TEST_SETTINGS_IMPORT_PATH=${source}" ${extra_env} "${APP}" --smoke-test --settings "${destination}"
    RESULT_VARIABLE result ERROR_VARIABLE error TIMEOUT 15)
  if(NOT result STREQUAL "0")
    message(FATAL_ERROR "SDL settings import (${mode}) failed (${result}): ${error}")
  endif()
  if(mode STREQUAL "invalid" AND NOT error MATCHES "Could not import settings")
    message(FATAL_ERROR "SDL did not report the failed import: ${error}")
  endif()
  file(READ "${destination}" settings)
  if(NOT settings MATCHES "Sound=${expected_sound}" OR NOT settings MATCHES "Keep=yes")
    message(FATAL_ERROR "Unexpected saved settings after ${mode}: ${settings}")
  endif()
  file(SHA256 "${source}" after)
  if(NOT after STREQUAL original)
    message(FATAL_ERROR "Import or conflicting screenshot modified the source")
  endif()
endforeach()
file(REMOVE "${source}" "${destination}")
