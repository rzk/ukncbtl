file(MAKE_DIRECTORY "${TEST_DIR}")
set(screenshot "${TEST_DIR}/screen-日本.png")
set(snapshot "${TEST_DIR}/state-日本.uknc")
set(trace "${TEST_DIR}/trace-日本.log")
file(REMOVE "${screenshot}" "${snapshot}" "${trace}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy
  UKNCBTL_TEST_SLOW_FRAME=1 "UKNCBTL_TEST_SCREENSHOT_PATH=${screenshot}"
  "UKNCBTL_TEST_SNAPSHOT_PATH=${snapshot}" "UKNCBTL_TEST_TRACE_PATH=${trace}"
  "${APP}" --smoke-test --sound RESULT_VARIABLE result ERROR_VARIABLE error TIMEOUT 25)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "SDL combined worker smoke test failed (${result}): ${error}")
endif()
foreach(path IN ITEMS "${screenshot}" "${snapshot}" "${trace}")
  if(NOT EXISTS "${path}")
    message(FATAL_ERROR "Worker output is missing: ${path}")
  endif()
endforeach()
file(READ "${screenshot}" png_header OFFSET 0 LIMIT 24 HEX)
file(SIZE "${snapshot}" snapshot_size)
file(READ "${snapshot}" snapshot_header OFFSET 0 LIMIT 12 HEX)
file(SIZE "${trace}" trace_size)
file(READ "${trace}" trace_prefix LIMIT 32)
if(NOT png_header MATCHES "^89504e470d0a1a0a0000000d494844520000028000000240")
  message(FATAL_ERROR "Combined-worker screenshot is invalid: ${png_header}")
endif()
if(NOT snapshot_size EQUAL 229888 OR NOT snapshot_header STREQUAL "554b4e4342544c2101000100")
  message(FATAL_ERROR "Combined-worker state image is invalid: ${snapshot_size}, ${snapshot_header}")
endif()
if(trace_size EQUAL 0 OR NOT trace_prefix MATCHES "^(CPU|PPU)")
  message(FATAL_ERROR "Combined-worker trace is invalid: ${trace_prefix}")
endif()
file(REMOVE "${screenshot}" "${snapshot}" "${trace}")
