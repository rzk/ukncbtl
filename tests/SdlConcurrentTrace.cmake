file(MAKE_DIRECTORY "${TEST_DIR}")
set(trace "${TEST_DIR}/worker-日本.log")
file(REMOVE "${trace}")
set(extra_env)
if(TEST_TRACE_FAILURE)
  list(APPEND extra_env UKNCBTL_TEST_TRACE_FAILURE=1)
endif()
if(TEST_TRACE_FAILURE_EXIT)
  list(APPEND extra_env UKNCBTL_TEST_TRACE_FAILURE_EXIT=1)
endif()
if(TEST_TRACE_RECORD_FAILURE)
  list(APPEND extra_env UKNCBTL_TEST_TRACE_RECORD_FAILURE=1)
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy
  "UKNCBTL_TEST_TRACE_PATH=${trace}" ${extra_env} "${APP}" --smoke-test --sound
  RESULT_VARIABLE result ERROR_VARIABLE error TIMEOUT 25)
if(NOT result EQUAL 0 OR NOT EXISTS "${trace}")
  message(FATAL_ERROR "SDL trace smoke test failed (${result}): ${error}")
endif()
if(TEST_TRACE_FAILURE_EXIT)
  if(NOT error MATCHES "Could not finish the trace output")
    message(FATAL_ERROR "Unacknowledged trace failure was not reported on exit: ${error}")
  endif()
  file(REMOVE "${trace}")
  return()
endif()
file(SIZE "${trace}" size)
if(size EQUAL 0)
  message(FATAL_ERROR "Trace was empty after shutdown")
endif()
file(READ "${trace}" prefix LIMIT 32)
if(NOT prefix MATCHES "^(CPU|PPU)")
  message(FATAL_ERROR "Trace did not start with a processor record: ${prefix}")
endif()
file(REMOVE "${trace}")
