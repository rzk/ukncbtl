if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT)
  message(FATAL_ERROR "INPUT and OUTPUT are required")
endif()
file(SIZE "${INPUT}" rom_size)
if(rom_size LESS 32256)
  message(FATAL_ERROR "The embedded ROM must contain at least 32256 bytes")
endif()
file(READ "${INPUT}" rom_hex LIMIT 32256 HEX)
string(REGEX REPLACE "(..)" "0x\\1," rom_bytes "${rom_hex}")
string(REPEAT "0x[0-9a-f][0-9a-f]," 16 row_pattern)
string(REGEX REPLACE "(${row_pattern})" "\\1\n" rom_rows "${rom_bytes}")
file(WRITE "${OUTPUT}" "${rom_rows}")
